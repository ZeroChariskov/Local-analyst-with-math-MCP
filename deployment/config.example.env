# Copy this file to config.env and edit the values.
# Do not commit config.env.

# Full path to llama-server executable.
TITAN_LLAMA_SERVER=__PATH_TO_LLAMA_SERVER__

# GGUF language model and matching vision projector.
TITAN_MODEL=__PATH_TO_MODEL_GGUF__
TITAN_MMPROJ=__PATH_TO_MMPROJ_GGUF__

# Gateway and upstream ports. llama-server must stay localhost-only.
TITAN_UPSTREAM_HOST=127.0.0.1
TITAN_UPSTREAM_PORT=8081
TITAN_GATEWAY_HOST=0.0.0.0
TITAN_GATEWAY_PORT=18080
TITAN_CONTEXT=160000
TITAN_PARALLEL=1
# Ask llama.cpp to offload every possible layer to CUDA.
TITAN_GPU_LAYERS=99999
TITAN_FLASH_ATTN=on
TITAN_CACHE_TYPE_K=q4_0
TITAN_CACHE_TYPE_V=q4_0
TITAN_BATCH=2048
TITAN_UBATCH=512
TITAN_JINJA=on
TITAN_IMAGE_MIN_TOKENS=1024
TITAN_MTP_MODEL=
TITAN_SPEC_TYPE=draft-mtp
TITAN_SPEC_DRAFT_N_MAX=2
# Temporary sanitized mobile request diagnostics. Keep off normally.
TITAN_DEBUG_REQUESTS=off
TITAN_MATH_ENABLED=on
TITAN_MATH_SERVER=__PATH_TO_PROJECT__\mcp\math\server.py
TITAN_MATH_CWD=__PATH_TO_PROJECT__\mcp\math
TITAN_MAX_TOOL_LOOPS=20
TITAN_MAX_QUEUE_SIZE=2
TITAN_QUEUE_TIMEOUT=1800

# Replace this with a long random value, for example 32+ random characters.
# Use separate keys per client. Values must be long random strings.
# Keep the legacy key only if an older client still needs it.
TITAN_API_KEY_DESKTOP=sk-titan-desktop-__REPLACE_WITH_RANDOM_VALUE__
TITAN_API_KEY_PHONE=sk-titan-phone-__REPLACE_WITH_RANDOM_VALUE__
TITAN_API_KEY_LOCAL=sk-titan-local-__REPLACE_WITH_RANDOM_VALUE__
