# Experimental quality-first profile. Keep the normal deployment/config.env
# unchanged and copy this file to deployment/config.quality.env when testing.

TITAN_LLAMA_SERVER=__PATH_TO_LLAMA_SERVER__
TITAN_MODEL=__PATH_TO_MODEL_GGUF__
TITAN_MMPROJ=__PATH_TO_MMPROJ_GGUF__

TITAN_UPSTREAM_HOST=127.0.0.1
TITAN_UPSTREAM_PORT=8081

# Qwen3.8 native context is 262144. 1048576 is a 4x YaRN experiment.
TITAN_CONTEXT=1048576
TITAN_PARALLEL=1

# 99999 means all possible layers, equivalent in intent to all/max.
TITAN_GPU_LAYERS=99999
TITAN_FLASH_ATTN=on
TITAN_CACHE_TYPE_K=f16
TITAN_CACHE_TYPE_V=f16
TITAN_BATCH=2048
TITAN_UBATCH=512
TITAN_JINJA=on
TITAN_IMAGE_MIN_TOKENS=1024

# Download the matching file before enabling this profile.
TITAN_MTP_MODEL=__PATH_TO_MTP_GGUF__
TITAN_SPEC_TYPE=draft-mtp
TITAN_SPEC_DRAFT_N_MAX=2

# YaRN: 1048576 / 262144 = 4.
TITAN_ROPE_SCALING=yarn
TITAN_ROPE_SCALE=4
